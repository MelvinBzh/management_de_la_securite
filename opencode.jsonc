{
  // Configuration projet opencode — E21 « Des agents IA pour analyser les risques ».
  //
  // Fournisseur local Ollama (https://ollama.com) : permet de faire tourner la
  // chaîne d'agents 100 % en local, sans appel API externe.
  //
  //   - Nécessite Ollama démarré sur la machine : `ollama serve` (port 11434).
  //   - Télécharger un modèle : `ollama pull llama3.1:8b` (ou mistral:7b,
  //     qwen3-vl:8b…). Un seul modèle chargé à la fois sur une carte 12 Go :
  //     `OLLAMA_MAX_LOADED_MODELS=1`.
  //   - Lister les modèles disponibles depuis opencode : `opencode models`.
  //   - Sélectionner un modèle Ollama : `opencode run --model ollama/qwen2.5:7b …`,
  //     ou depuis l'interface web E21 (page « Studio E21 » → état Ollama).
  //
  // Ce bloc n'écrase PAS le modèle configuré par ailleurs (ex. big-pickle via
  // l'environnement) : il ajoute simplement « ollama » comme fournisseur
  // supplémentaire. Sans serveur Ollama actif, ce fournisseur est simplement
  // inutilisé — aucune des deux configurations ne casse.
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        // Modèles déclarés pour que `ollama/<modèle>` soit résolvable par opencode
        // (les agents choisissent leur modèle par `model:` dans leur en-tête, cf.
        // `make agents-modele PROFIL=ollama`). Déclaration sans effet sur le réseau :
        // un modèle absent du serveur Ollama n'est appelé que si un agent le réclame.
        //
        // Sélection par agent pour une carte 12 Go : `web/modeles_ollama.py`.
        //
        // `limit` est OBLIGATOIRE pour les fournisseurs locaux : opencode ne connaît
        // pas les modèles Ollama (absents de son cache models.dev) et applique sans
        // cela son défaut — contexte 4096 / sortie 2048 — ce qui fait exploser le
        // budget des agents (« finish: length », aucune action, chaîne vide).
        //
        // Avertissement : ces limites déclarent ce qu'opencode PEUT envoyer. Le
        // serveur Ollama, lui, tronque le prompt à sa fenêtre effective (`num_ctx`,
        // défaut 2048) SANS erreur ni avertissement. Les valeurs ci-dessous ne sont
        // utilisables que si le serveur est réglé en conséquence :
        // `OLLAMA_CONTEXT_LENGTH=16384` (ou un Modelfile `PARAMETER num_ctx 16384`).
        // La sonde de lancement (web/reglages.py) mesure le plafond réel et alerte.
        // Modèles testés pour l'appel d'outils (audit 2026-10-09) : qwen3:8b = 6/6 appels valides,
        // llama3.1:8b / mistral:7b / qwen3-vl:8b = 4/6 seulement → inutilisables pour piloter la chaîne.
        "qwen3:8b":           { "name": "qwen3:8b",           "limit": { "context": 16384, "output": 8192 } },   // recommandé (outils fiables)
        "qwen3:14b":          { "name": "qwen3:14b",          "limit": { "context": 16384, "output": 8192 } },   // plus capable, serré sur 12 Go
        "qwen2.5:7b-instruct": { "name": "qwen2.5:7b-instruct", "limit": { "context": 16384, "output": 4096 } }, // sans thinking, rapide
        "llama3.1:8b": { "name": "llama3.1:8b", "limit": { "context": 16384, "output": 4096 } },   // raisonnement (par défaut E21)
        "mistral:7b":  { "name": "mistral:7b",  "limit": { "context": 16384, "output": 4096 } },   // rédaction rapide
        "qwen3-vl:8b": { "name": "qwen3-vl:8b", "limit": { "context": 16384, "output": 8192 } },   // lecture d'images + raisonnement (thinking)
        "llava:7b":    { "name": "llava:7b",    "limit": { "context": 16384, "output": 4096 } },   // vision (déprécié)
        "qwen2.5:7b":  { "name": "qwen2.5:7b",  "limit": { "context": 16384, "output": 4096 } }    // sorties structurées
      }
    }
  }
}