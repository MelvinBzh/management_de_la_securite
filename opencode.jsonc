{
  // Configuration projet opencode — E21 « Des agents IA pour analyser les risques ».
  //
  // Fournisseur local Ollama (https://ollama.com) : permet de faire tourner la
  // chaîne d'agents 100 % en local, sans appel API externe.
  //
  //   - Nécessite Ollama démarré sur la machine : `ollama serve` (port 11434).
  //   - Télécharger un modèle : `ollama pull llama3.1:8b` (ou mistral:7b,
  //     qwen3-vl:8b…). Un seul modèle chargé à la fois sur une carte 12 Go :
  //     `OLLAMA_MAX_LOADED_MODELS=1`.
  //   - Lister les modèles disponibles depuis opencode : `opencode models`.
  //   - Sélectionner un modèle Ollama : `opencode run --model ollama/qwen2.5:7b …`,
  //     ou depuis l'interface web E21 (page « Studio E21 » → état Ollama).
  //
  // Ce bloc n'écrase PAS le modèle configuré par ailleurs (ex. big-pickle via
  // l'environnement) : il ajoute simplement « ollama » comme fournisseur
  // supplémentaire. Sans serveur Ollama actif, ce fournisseur est simplement
  // inutilisé — aucune des deux configurations ne casse.
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        // Modèles déclarés pour que `ollama/<modèle>` soit résolvable par opencode
        // (les agents choisissent leur modèle par `model:` dans leur en-tête, cf.
        // `make agents-modele PROFIL=ollama`). Déclaration sans effet sur le réseau :
        // un modèle absent du serveur Ollama n'est appelé que si un agent le réclame.
        //
        // Sélection par agent pour une carte 12 Go : `web/modeles_ollama.py`.
        "llama3.1:8b": { "name": "llama3.1:8b" },   // raisonnement (par défaut E21)
        "mistral:7b":  { "name": "mistral:7b" },    // rédaction rapide
        "qwen3-vl:8b": { "name": "qwen3-vl:8b" },   // lecture d'images (multimodal)
        "llava:7b":    { "name": "llava:7b" },      // vision (déprécié)
        "qwen2.5:7b":  { "name": "qwen2.5:7b" }     // sorties structurées
      }
    }
  }
}