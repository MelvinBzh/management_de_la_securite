# Exemple de configuration pour le déploiement Docker.
# Copiez ce fichier en `.env` (ignoré par git) et renseignez vos clés :
#   cp .env.exemple .env
#
# Sans clé, l'application fonctionne à 100 % en local avec Ollama
# (`network_mode: host` → http://localhost:11434, voir opencode.jsonc).

# Clé Anthropic (modèles Claude) — facultative.
ANTHROPIC_API_KEY=

# Clé OpenAI (modèles GPT) — facultative.
OPENAI_API_KEY=